{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/connect/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/sdPython.worker-(.*).js",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' https://cdn.jsdelivr.net/pyodide/v0.27.5/full/ 'wasm-unsafe-eval'; connect-src https://cdn.jsdelivr.net/pyodide/v0.27.5/full/; worker-src 'none'"
        }
      ]
    }
  ]
}
